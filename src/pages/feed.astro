---
import Layout from '../components/Layout.astro';
import feedData from '../data/feed.json';

const items = feedData.items || [];
const allTags = Array.from(new Set(items.flatMap(i => [...(i.tags || []), ...(i.technologies || [])])));
---

<Layout title="Единая Лента Публикаций | Portfolio Factory" description="Проектные кейсы, архитектурные решения и надиктованные статьи">
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h1 class="text-4xl font-bold text-white mb-4 tracking-tight">Единая лента материалов</h1>
        <p class="text-gray-400 text-lg max-w-2xl">
          Интерактивный поток всех проектных кейсов, инженерных решений (ADR) и надиктованных заметок/статей.
        </p>
      </div>

      <!-- Type Filters & Tags -->
      <div class="flex flex-wrap gap-3 mb-10 pb-6 border-b border-white/10" id="filter-bar">
        <button class="filter-btn active px-4 py-2 rounded-xl text-sm font-medium glass hover:bg-white/10 text-white transition-all" data-type="all">
          Все ({items.length})
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl text-sm font-medium glass hover:bg-white/10 text-gray-400 hover:text-white transition-all" data-type="case">
          Кейсы проектов
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl text-sm font-medium glass hover:bg-white/10 text-gray-400 hover:text-white transition-all" data-type="decision">
          Архитектурные решения
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl text-sm font-medium glass hover:bg-white/10 text-gray-400 hover:text-white transition-all" data-type="article">
          Статьи & Заметки
        </button>
      </div>

      <!-- Items Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="feed-grid">
        {items.map((item) => (
          <article class="feed-item group block p-8 rounded-2xl glass hover:border-accent/50 transition-all duration-300" data-item-type={item.type}>
            <div class="flex justify-between items-start mb-4">
              <span class={`px-3 py-1 rounded-md text-xs font-mono border ${
                item.type === 'case' ? 'bg-blue-500/10 border-blue-500/30 text-blue-400' :
                item.type === 'decision' ? 'bg-purple-500/10 border-purple-500/30 text-purple-400' :
                'bg-emerald-500/10 border-emerald-500/30 text-emerald-400'
              }`}>
                {item.type === 'case' ? 'PROJECT CASE' : item.type === 'decision' ? 'ADR DECISION' : 'ARTICLE'}
              </span>
              {item.type === 'case' && (
                <a href={`/cases/${item.id.replace('case-', '')}`} class="text-xs text-accent hover:underline flex items-center gap-1">
                  Подробнее &rarr;
                </a>
              )}
            </div>

            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-accent transition-colors">{item.title}</h3>
            <p class="text-gray-400 text-sm mb-6 line-clamp-3 leading-relaxed">{item.summary}</p>

            <div class="flex flex-wrap gap-2 pt-4 border-t border-white/5">
              {(item.technologies || []).concat(item.tags || []).slice(0, 5).map((tag) => (
                <span class="px-2 py-0.5 rounded bg-white/5 text-gray-400 text-xs font-mono">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const articles = document.querySelectorAll('.feed-item');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('active', 'text-white');
          b.classList.add('text-gray-400');
        });
        btn.classList.add('active', 'text-white');
        btn.classList.remove('text-gray-400');

        const targetType = btn.getAttribute('data-type');
        articles.forEach(article => {
          const itemType = article.getAttribute('data-item-type');
          if (targetType === 'all' || itemType === targetType) {
            (article as HTMLElement).style.display = 'block';
          } else {
            (article as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
