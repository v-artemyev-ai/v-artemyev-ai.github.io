---
// Contacts section
import { siteConfig } from '../config/site.js';
---

<section id="contacts" class="py-20 lg:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-accent text-sm font-semibold uppercase tracking-wider mb-3">Контакты</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Обсудим вашу задачу
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Напишите — расскажу про подход, сроки и стоимость.
        Первичная консультация бесплатно.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Telegram -->
      <a
        href={siteConfig.social.telegram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="glass p-6 text-center group hover:bg-white/[0.07] transition-all duration-300 block"
      >
        <div class="w-14 h-14 rounded-xl bg-accent/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-accent/20 transition-colors">
          <svg class="w-7 h-7 text-accent" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.161c-.18 1.897-.962 6.502-1.359 8.627-.168.9-.5 1.201-.82 1.23-.697.064-1.226-.461-1.901-.903-1.056-.693-1.653-1.123-2.678-1.799-1.185-.781-.417-1.21.258-1.911.177-.184 3.247-2.977 3.307-3.23.007-.032.02-.15-.057-.212s-.174-.041-.249-.024c-.106.024-1.793 1.139-5.062 3.345-.479.329-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.244-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.831-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635.099-.002.321.023.465.141.12.098.152.229.166.327.016.108.035.35.02.541z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-1">Telegram</h3>
        <p class="text-gray-400 text-sm">{siteConfig.social.telegram.label}</p>
      </a>

      <!-- Email -->
      <a
        href={siteConfig.social.email.url}
        class="glass p-6 text-center group hover:bg-white/[0.07] transition-all duration-300 block"
      >
        <div class="w-14 h-14 rounded-xl bg-blue-500/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-blue-500/20 transition-colors">
          <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-1">Email</h3>
        <p class="text-gray-400 text-sm break-all">{siteConfig.social.email.label}</p>
      </a>

      <!-- GitHub -->
      <a
        href={siteConfig.social.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="glass p-6 text-center group hover:bg-white/[0.07] transition-all duration-300 block"
      >
        <div class="w-14 h-14 rounded-xl bg-purple-500/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-purple-500/20 transition-colors">
          <svg class="w-7 h-7 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-1">GitHub</h3>
        <p class="text-gray-400 text-sm">Код и архитектура</p>
      </a>

      <!-- LinkedIn -->
      <a
        href={siteConfig.social.linkedin.url}
        target="_blank"
        rel="noopener noreferrer"
        class="glass p-6 text-center group hover:bg-white/[0.07] transition-all duration-300 block"
      >
        <div class="w-14 h-14 rounded-xl bg-sky-500/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-sky-500/20 transition-colors">
          <svg class="w-7 h-7 text-sky-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.239-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-1">LinkedIn</h3>
        <p class="text-gray-400 text-sm">Профессиональный профиль</p>
      </a>
    </div>
  </div>
</section>
